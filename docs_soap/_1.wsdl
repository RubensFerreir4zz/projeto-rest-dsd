      <wsdlsoap11:operation soapAction="emitir_autenticacao_arquivo" style="document"/>
      <wsdl:input name="emitir_autenticacao_arquivo">
        <wsdlsoap11:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="emitir_autenticacao_arquivoResponse">
        <wsdlsoap11:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="validar_integridade_arquivo">
      <wsdlsoap11:operation soapAction="validar_integridade_arquivo" style="document"/>
      <wsdl:input name="validar_integridade_arquivo">
        <wsdlsoap11:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="validar_integridade_arquivoResponse">
        <wsdlsoap11:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
