      </xs:complexType>
      <xs:complexType name="emitir_autenticacao_arquivoResponse">
        <xs:sequence>
          <xs:element name="emitir_autenticacao_arquivoResult" type="tns:CertificadoAutenticacaoResponse" minOccurs="0" nillable="true"/>
