    </wsdl:operation>
    <wsdl:operation name="validar_integridade_arquivo" parameterOrder="validar_integridade_arquivo">
      <wsdl:documentation>Operação 2: A Autoridade SOAP audita a integridade do arquivo.
Confere se o arquivo no disco foi alterado ou compara contra um hash informado.
Dispara SOAP Fault caso seja detectada qualquer divergência de integridade.</wsdl:documentation>
      <wsdl:input name="validar_integridade_arquivo" message="tns:validar_integridade_arquivo"/>
      <wsdl:output name="validar_integridade_arquivoResponse" message="tns:validar_integridade_arquivoResponse"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="SafoDriveNotary" type="tns:SafoDriveNotary">
    <wsdlsoap11:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
