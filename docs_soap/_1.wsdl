      <xs:element name="ValidacaoIntegridadeResponse" type="tns:ValidacaoIntegridadeResponse"/>
      <xs:element name="emitir_autenticacao_arquivo" type="tns:emitir_autenticacao_arquivo"/>
      <xs:element name="validar_integridade_arquivo" type="tns:validar_integridade_arquivo"/>
