    <wsdl:part name="validar_integridade_arquivoResponse" element="tns:validar_integridade_arquivoResponse"/>
  </wsdl:message>
  <wsdl:service name="FileShareNotaryService">
    <wsdl:port name="SafoDriveNotary" binding="tns:SafoDriveNotary">
      <wsdlsoap11:address location="http://localhost:8003/"/>
    </wsdl:port>
  </wsdl:service>
  <wsdl:portType name="SafoDriveNotary">
    <wsdl:operation name="emitir_autenticacao_arquivo" parameterOrder="emitir_autenticacao_arquivo">
      <wsdl:input name="emitir_autenticacao_arquivo" message="tns:emitir_autenticacao_arquivo"/>
